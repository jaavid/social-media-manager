# =============================================================================
# Social Stats — single deployment environment file
# Copy to .env, change secrets/domain values, then run:
#   docker compose pull && docker compose up -d
# =============================================================================

# Public app
APP_BIND=127.0.0.1
APP_PORT=3000
APP_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
# Public Next values are baked into source builds. APP_URL also sets metadata origin.
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_WS_URL=wss://app.example.com
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=app.example.com
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
DEBUG=False
# JSON application logs on stdout: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# For machine-readable management-command exports only: LOG_STREAM=stderr

# Shared, payload-free Celery counters; Compose enables these by default.
RUNTIME_METRICS_ENABLED=True
# Optional dedicated Redis database/instance (otherwise uses the Celery broker).
# RUNTIME_METRICS_REDIS_URL=redis://redis:6379/2

# Trust real-client-IP headers only when the origin/app is reachable exclusively
# through a trusted reverse proxy/CDN. For ArvanCloud-protected origins set True;
# the app prefers ArvanCloud's ar-real-ip header and falls back to X-Real-IP/XFF.
TRUST_PROXY_CLIENT_IP=False

# Optional image override. Default in compose:
# ghcr.io/jaavid/social-stats-app:latest
# SOCIAL_STATS_APP_IMAGE=ghcr.io/jaavid/social-stats-app:latest

# Core secrets
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# PostgreSQL — DB_HOST/DB_PORT are wired automatically by compose
POSTGRES_DB=socialstats
POSTGRES_USER=socialstats
POSTGRES_PASSWORD=change-me-to-a-strong-database-password

# HTTPS/cookies
# When TLS is terminated by Traefik/Caddy/Nginx in front of this stack, set
# APP_URL=https://your-domain.example and normally enable secure cookies.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Set the exact public frontend origin when Next proxies to a separate Django host.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_HSTS_SECONDS=0

# Organization SSO — generic OpenID Connect (Authentik / Keycloak / Entra ID)
# Authentik issuer example:
#   https://auth.example.com/application/o/social-stats
# Register this redirect URI in the provider exactly as configured below.
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback/
SSO_OIDC_LABEL=Organization SSO
SSO_OIDC_SCOPES=openid email profile
# Optional comma-separated allowlist, for example: example.com,example.org
SSO_OIDC_ALLOWED_DOMAINS=
# Secure default: require the provider to assert email_verified=true before
# linking SSO to an existing local account. Authentik 2025.10+ defaults this
# claim to false; configure an authoritative email scope mapping in Authentik.
# Set False only when the IdP itself authoritatively controls users' email values.
SSO_OIDC_REQUIRE_VERIFIED_EMAIL=True
# Keep False in production. Useful only for a deliberately HTTP-only dev IdP.
SSO_OIDC_ALLOW_INSECURE=False

# Optional outbound API gateway
API_GATEWAY_URL=
API_GATEWAY_KEY=
OUTBOUND_ROUTING_DEFAULT=auto
OUTBOUND_CIRCUIT_TTL_SECONDS=300
OUTBOUND_TELEGRAM_MODE=auto
OUTBOUND_BALE_MODE=auto
OUTBOUND_META_MODE=auto
OUTBOUND_GOOGLE_MODE=auto
OUTBOUND_GOOGLE_OAUTH_MODE=auto
OUTBOUND_GOOGLE_UPLOAD_MODE=auto
OUTBOUND_LINKEDIN_MODE=auto

# Meta / Facebook / Instagram
META_APP_ID=
META_APP_SECRET=
# Keep the Graph API version explicit so upgrades are deliberate.
META_API_VERSION=v25.0
# Example: https://social.example.com/api/oauth/facebook/callback/
META_REDIRECT_URI=

# Google / YouTube / Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example: https://social.example.com/api/oauth/google/callback/
GOOGLE_REDIRECT_URI=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Example: https://social.example.com/api/oauth/linkedin/callback/
LINKEDIN_REDIRECT_URI=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# AI
ANTHROPIC_API_KEY=

# WhatsApp / Pinbot
PINBOT_BASE_URL=https://partnersv1.pinbot.ai/v3
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_RATE_LIMIT_PER_SEC=20

# OAuth rollout
OAUTH_APPS_APPROVED=False

# Optional CAPTCHA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional public backend URL / Google deletion webhook verification
BACKEND_PUBLIC_URL=
GOOGLE_DELETION_SHARED_SECRET=

# Uploaded files (private S3-compatible bucket; local is the development default)
MEDIA_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=us-east-1
S3_ADDRESSING_STYLE=path
S3_KEY_PREFIX=media
S3_URL_EXPIRE_SECONDS=3600
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
