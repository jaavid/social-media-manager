# Export these before building, or place them in next/.env.local.
NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_SITE_URL=https://app.example.com
# NEXT_PUBLIC_WS_URL=wss://app.example.com
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=app.example.com
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
# Local Next development proxies API/media/backend to Django on port 8000.
# NEXT_BACKEND_URL=http://127.0.0.1:8000
# Existing REACT_APP_API_URL/WS_URL/PLAUSIBLE_* deployments remain compatible.
# NEXT_PUBLIC_* values are public build-time values. Never put secrets here.
