# Frontend environment variables (Vite).
# Copy this file to `.env` and adjust for your environment before `npm run dev`.

# Backend API base URL. For local dev, the Django dev server listens on 8000.
VITE_API_URL=http://localhost:8000/api

# Optional websocket endpoint. When omitted, the app derives it from the API URL.
# VITE_WS_URL=ws://localhost:8000

# Optional privacy-friendly analytics settings.
# VITE_PLAUSIBLE_DOMAIN=example.com
# VITE_PLAUSIBLE_HOST=https://plausible.io

# The Vite config still accepts the legacy REACT_APP_* names during the
# transition so existing Docker/deployment configuration keeps working.
