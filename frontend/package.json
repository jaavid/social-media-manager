{
  "name": "social-dashboard-frontend",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^3.3.1",
    "dompurify": "^3.4.16",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.330.0",
    "nanoid": "^5.1.11",
    "next": "16.3.8",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^6.22.0",
    "react-swipeable": "^7.0.2",
    "reactflow": "^11.11.4",
    "recharts": "^2.10.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-jest": "^29.7.0",
    "caniuse-lite": "^1.0.30001813",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "whatwg-fetch": "^3.6.20"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watch",
    "i18n:inventory": "node scripts/check-user-facing-strings.js",
    "i18n:check": "node scripts/check-user-facing-strings.js --check",
    "typecheck": "tsc --noEmit",
    "dev:next": "next dev next --webpack --hostname 0.0.0.0 --port 3001",
    "build:next": "next build next --webpack",
    "start:next": "node scripts/start-next.mjs",
    "test:next": "playwright test",
    "build:rollout": "REACT_APP_NEXT_ENABLED=true vite build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^@radix-ui/primitive/is-development$": "<rootDir>/node_modules/@radix-ui/primitive/dist/internal/is-development.true.js",
      "\\.(css|less|scss)$": "<rootDir>/src/testStyleMock.js"
    },
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.[jt]s?(x)"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            [
              "@babel/preset-react",
              {
                "runtime": "automatic"
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "roots": [
      "<rootDir>/src"
    ]
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
